{
  "name": "@who-tech/web",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:visual": "NEXT_PUBLIC_API_URL=http://127.0.0.1:4010 next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "test": "NODE_OPTIONS=--experimental-require-module vitest run",
    "test:watch": "NODE_OPTIONS=--experimental-require-module vitest",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:mutation": "NODE_OPTIONS=--experimental-require-module stryker run"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.57.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^27.3.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}

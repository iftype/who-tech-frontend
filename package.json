{
  "name": "who-tech-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@who-tech/web",
    "dev:app": "pnpm --filter @who-tech/mobile dev",
    "dev:app-ios": "pnpm --filter @who-tech/mobile dev:ios",
    "dev:app-android": "pnpm --filter @who-tech/mobile dev:android",
    "build:web": "turbo run build --filter=@who-tech/web",
    "build:app": "pnpm build:app-ios && pnpm build:app-android",
    "build:app-ios": "pnpm --filter @who-tech/mobile ios",
    "build:app-android": "pnpm --filter @who-tech/mobile android",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
